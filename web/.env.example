# Variables du front-end web, à copier dans .env.local (ignoré par Git) et à compléter.

# Secret de chiffrement du cookie de session (32 octets aléatoires au moins), propre à chaque poste :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Client OIDC du front-end (Keycloak de dev : client public gestion-temps-web, PKCE)
AUTH_KEYCLOAK_ID=gestion-temps-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/gestion-temps
# Secret du client, seulement si le client est confidentiel (vide pour un client public)
AUTH_KEYCLOAK_SECRET=

# Revendication du jeton d'accès portant les rôles (même valeur que OIDC_ROLES_CLAIM de l'API)
AUTH_ROLES_CLAIM=roles

# URL de l'API gestion-temps, appelée par le serveur Next.js uniquement
API_URL=http://localhost:8080
