# Variables du front-end web, à copier dans .env.local (ignoré par Git) et à compléter.

# Secret de chiffrement du cookie de session (32 caractères au moins), propre à chaque poste :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Fournisseur OIDC et client du front-end (Keycloak de dev : client public gestion-temps-web, PKCE)
OIDC_ISSUER_URI=http://localhost:8180/realms/gestion-temps
OIDC_CLIENT_ID=gestion-temps-web
# Secret du client, seulement si le client est confidentiel (vide pour un client public)
OIDC_CLIENT_SECRET=

# Revendication du jeton d'accès portant les rôles (même valeur que OIDC_ROLES_CLAIM de l'API)
OIDC_ROLES_CLAIM=roles

# Adresse publique de l'application (production, derrière le reverse proxy) : adresse de retour du
# fournisseur et cookies Secure en https. Vide en dev : déduite de la requête.
APP_URL=

# URL de l'API gestion-temps, appelée par le serveur Next.js uniquement
API_URL=http://localhost:8080
