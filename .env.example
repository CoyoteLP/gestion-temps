# Modèle des variables d'environnement (base de données et fournisseur OIDC, profil dev ; variables
# propres à la production en fin de fichier, détaillées dans le README, section « Exploitation »).
# 1. Copier ce fichier en .env à la racine du projet : cp .env.example .env
# 2. Renseigner les valeurs dans .env (ce fichier-là n'est pas versionné).
# Ne jamais mettre de vraies valeurs dans .env.example.

# URL JDBC, ex. jdbc:mariadb://localhost:3306/gestion_temps?createDatabaseIfNotExist=true
DB_URL=

# Identifiants MariaDB
DB_USERNAME=
DB_PASSWORD=

# Fournisseur OIDC qui émet les jetons d'accès, ex. https://keycloak.exemple.fr/realms/lirox
# Keycloak de développement (docker/keycloak/compose.yaml) : http://localhost:8180/realms/gestion-temps
OIDC_ISSUER_URI=

# Destinataire attendu des jetons (revendication aud), ex. gestion-temps-api ; les jetons émis pour
# une autre application du même fournisseur sont refusés
OIDC_AUDIENCE=

# Facultatif : chemin de la revendication des rôles dans le jeton (par défaut : roles)
# OIDC_ROLES_CLAIM=realm_access.roles

# Facultatif : accepter un jeton sans revendication email_verified pour le rattachement par email
# (par défaut : true = exigée). À réserver aux fournisseurs qui garantissent les emails.
# OIDC_EXIGER_EMAIL_VERIFIE=false

# ---- Production uniquement (profil prod), toutes facultatives ----

# Compte des migrations Flyway, au démarrage (par défaut : DB_USERNAME / DB_PASSWORD) ; permet de
# réserver les droits de modification du schéma à ce compte
# FLYWAY_USERNAME=
# FLYWAY_PASSWORD=

# Connexions simultanées à la base par instance (par défaut : 10)
# DB_POOL_MAX=

# Port d'Actuator : santé, métriques Prometheus (par défaut : 8081, réseau interne uniquement)
# MANAGEMENT_PORT=

# Publier la documentation OpenAPI (par défaut : false)
# OPENAPI_ACTIVE=
