# Format commun des fichiers, appliqué par la plupart des éditeurs (VS Code avec l'extension
# EditorConfig, IntelliJ, Eclipse...). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# YAML et Markdown ne supportent pas (ou mal) les tabulations
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
